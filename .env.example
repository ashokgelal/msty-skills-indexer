# Required for upload mode.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=msty-skills-index

# Optional cache purge after upload. If CF_API_TOKEN and CF_ZONE_ID are set,
# the stable mstySkills URLs are purged automatically. CF_PURGE_URLS can add
# extra comma-separated URLs.
CF_API_TOKEN=
CF_ZONE_ID=
CF_PURGE_URLS=

# Optional.
R2_PREFIX=app/latest/assets/mstySkills
PUBLIC_BASE_URL=
UPLOAD_SOURCE_DIR=
UPLOAD_ENV_FILE=.env

# Scraper tuning.
MAX_DETAIL_PAGES=1000
DETAIL_CONCURRENCY=2
DETAIL_DELAY_MS=250
DETAIL_REFRESH_HOURS=168
POPULAR_REFRESH_HOURS=6
POPULAR_INSTALL_THRESHOLD=10000
USER_AGENT=MstySkillsIndexer/0.1 (+https://github.com/mstystudio/msty-skills-indexer)
DRY_RUN=0
